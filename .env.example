# 必填：把下面的占位值替换为自己的真实 DeepSeek API Key；不要提交包含密钥的 .env。
DEEPSEEK_API_KEY=replace_with_your_api_key
# 使用 DeepSeek 官方接口时通常无需修改；使用兼容服务时改为该服务提供的 Base URL。
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 如果当前账号或兼容服务不支持此模型，请改为服务实际提供的模型名称。
DEEPSEEK_MODEL=deepseek-v4-flash
# 可选：需要联网搜索时取消下一行注释并替换占位值；搜索词会发送给 Tavily。
# TAVILY_API_KEY=replace_with_your_tavily_api_key
AGENT_WEB_SEARCH_TIMEOUT=20
# 普通 unrestricted 搜索省略 max_results 时的默认返回数量，可设置为 1 到 10。
AGENT_WEB_SEARCH_MAX_RESULTS=5
# 搜索结果最低相关度，范围 0 到 1，默认 0.25；调高会更严格，也可能减少可用来源。
AGENT_WEB_SEARCH_MIN_SCORE=0.25
# 默认检索范围：balanced=一次工具调用并行检索国内和国际来源；也可填写 domestic、international 或 unrestricted。
AGENT_WEB_SEARCH_DEFAULT_SCOPE=balanced
# 国内检索省略 max_results 时的期望返回数量，可设置为 1 到 10；结果质量不足时可能少于此值。
AGENT_WEB_SEARCH_DOMESTIC_RESULTS=3
# 国际检索省略 max_results 时的期望返回数量，可设置为 1 到 10；结果质量不足时可能少于此值。
AGENT_WEB_SEARCH_INTERNATIONAL_RESULTS=3
# 可选：用英文逗号分隔域名。配置后相应范围只搜索这些站点；只写域名，不写 https://、路径或 *。
# 留空表示不限制。以下均为示例，使用前请删除 # 并替换为你信任的真实来源域名。
# AGENT_WEB_SEARCH_DOMESTIC_DOMAINS=gov.cn,xinhuanet.com
# AGENT_WEB_SEARCH_INTERNATIONAL_DOMAINS=reuters.com,apnews.com
# 可选：国内、国际和不限范围都排除的域名；格式同上。
# AGENT_WEB_SEARCH_EXCLUDED_DOMAINS=example.com
# 自动额度按真实网络请求计数：默认一次 balanced 正好使用 2 次额度；重复或超额时确认。可设置为 0 到 5。
AGENT_WEB_SEARCH_AUTO_CALLS_PER_TURN=2
# 网页正文读取超时秒数；它和搜索共用 TAVILY_API_KEY，但只在模型选定具体来源后调用。
AGENT_WEB_PAGE_TIMEOUT=20
# 单次最多批量读取的来源数，范围 1 到 4；默认允许一次完成多来源核对。
AGENT_WEB_PAGE_MAX_PAGES_PER_CALL=4
# 每轮无需确认即可读取的页面总数，范围 0 到 12；重复 URL 始终需要确认。
AGENT_WEB_PAGE_AUTO_PAGES_PER_TURN=4
# 每个来源围绕核对问题提取的相关片段数，范围 1 到 5；越大占用的上下文越多。
AGENT_WEB_PAGE_CHUNKS_PER_SOURCE=3
# basic 成本和延迟较低；advanced 更适合表格、嵌入内容或动态页面，但消耗更多 Tavily 额度。
AGENT_WEB_PAGE_EXTRACT_DEPTH=basic
# 每个来源返回给模型的正文字符上限，范围 1 到 20000，防止网页挤占整个对话上下文。
AGENT_WEB_PAGE_MAX_CONTENT_CHARS=6000
DEEPSEEK_MAX_CONTEXT_TOKENS=8000
DEEPSEEK_REQUEST_TIMEOUT=60
DEEPSEEK_MAX_RETRIES=3
DEEPSEEK_RETRY_BASE_DELAY=1
AGENT_LOG_LEVEL=INFO
# 可选：取消下一行注释，并把示例路径完整替换为允许 Agent 访问的绝对目录；
# 未设置时使用项目根目录。Windows 路径建议使用正斜杠，例如 D:/projects/demo。
# AGENT_WORKSPACE=C:/path/to/your/workspace
AGENT_MAX_FILE_SIZE=100000
AGENT_COMMAND_TIMEOUT=120
AGENT_MAX_COMMAND_OUTPUT=50000
# local 不需要 Docker，但 Python 仍拥有当前用户权限，只应用于可信工作区。
# docker 需要已启动的 Docker 服务，并会在一次性工作区副本中隔离运行 Python。
AGENT_COMMAND_EXECUTION_MODE=local
# Docker 模式不会自动下载镜像；首次使用前执行：docker pull python:3.10-slim
# 生产环境建议改为经过审计并固定 digest 的镜像。
AGENT_COMMAND_CONTAINER_IMAGE=python:3.10-slim
# 单轮最多允许的模型执行步数；复杂任务可按需调整。
AGENT_MAX_STEPS=12
# 常规步数耗尽后，仅允许闭合计划和输出最终回答的额外步数；设为 0 可禁用。
AGENT_MAX_FINALIZATION_STEPS=2
