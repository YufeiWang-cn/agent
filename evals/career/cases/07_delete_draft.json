          },
          "bind": "fact"
        },
        {
          "tool": "build_resume_draft",
          "arguments": {
            "fact_ids": [
              {
                "$ref": "fact.id"
              }
            ]
          },
          "bind": "draft"
        }
      ],
      "answer": "已完成本轮处理。",
